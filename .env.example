# Personal AI Workspace Environment Configuration
# Copy this file to .env and adjust your settings:
#   cp .env.example .env && chmod 600 .env

# --- General System Settings ---
COMPOSE_PROJECT_NAME=paw
PAW_DATA_DIR=./data
PAW_PUBLIC_URL=http://localhost:3000
PAW_BIND_ADDRESS=127.0.0.1
PAW_PORT=3000

# Stock Open WebUI direct access port (for admin operations and fallback PWA)
OPENWEBUI_BIND_ADDRESS=127.0.0.1
OPENWEBUI_PORT=3001
OPENWEBUI_PUBLIC_URL=http://localhost:3001

# --- Pinned Container Images ---
OPENWEBUI_IMAGE=ghcr.io/open-webui/open-webui:v0.12.0
PAW_API_IMAGE=ghcr.io/personal-ai-workspace/paw-api:local

# --- Cryptographic Secrets ---
# Generate using: openssl rand -hex 32
WEBUI_SECRET_KEY=replace_with_a_secure_random_hex_string_min_32_bytes
PAW_SESSION_SECRET=replace_with_another_secure_random_hex_string_32_bytes

# --- Authentication & Users ---
ENABLE_SIGNUP=false
DEFAULT_USER_ROLE=pending
PAW_COOKIE_SECURE=auto

# --- AI Model Providers ---
# External OpenAI-compatible provider (e.g. OpenAI, OpenRouter, Groq, Anthropic-compatible proxies)
ENABLE_OPENAI_API=true
OPENAI_API_BASE_URLS=https://api.openai.com/v1
OPENAI_API_KEYS=

# Optional Local Ollama (set to true if running Ollama locally or on host)
ENABLE_OLLAMA_API=false
OLLAMA_BASE_URL=http://ollama:11434

# --- Sub-agents (Parallel Workers) ---
ENABLE_SUBAGENTS=true
SUBAGENTS_MAX_CONCURRENT=8
SUBAGENTS_MAX_ASYNC=8
SUBAGENTS_MAX_ITERATIONS=30
SUBAGENTS_MAX_OUTPUT=30000

# --- Web Search ---
ENABLE_WEB_SEARCH=true
# Engines: duckduckgo, openserp (local Google/Bing via compose.search.yaml), or searxng
WEB_SEARCH_ENGINE=duckduckgo
OPENSERP_BASE_URL=http://openserp:7000
SEARXNG_SECRET=

# --- Image Generation ---
ENABLE_IMAGE_GENERATION=false
IMAGE_GENERATION_ENGINE=openai
IMAGES_OPENAI_API_BASE_URL=https://api.openai.com/v1
IMAGES_OPENAI_API_KEY=
IMAGE_GENERATION_MODEL=gpt-image-1

# --- Audio STT / TTS ---
AUDIO_STT_ENGINE=
AUDIO_TTS_ENGINE=

# --- Sandboxed Execution & Terminal ---
PAW_TERMINAL_URL=
PAW_TERMINAL_API_KEY=

# --- YouTube Transcripts ---
PAW_YOUTUBE_ENABLED=true

# --- Quotas & Resource Constraints ---
PAW_MAX_UPLOAD_MB=100
PAW_MONTHLY_BUDGET_USD=10
OPENWEBUI_MEM_LIMIT=3g
OPENWEBUI_CPUS=4
PAW_API_MEM_LIMIT=768m
PAW_API_CPUS=2

# --- Android TWA Digital Asset Links ---
PAW_ANDROID_PACKAGE=com.personalai.workspace
PAW_ANDROID_CERT_SHA256=
